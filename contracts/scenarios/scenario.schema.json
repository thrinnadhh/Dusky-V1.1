{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "application": { "enum": ["Customer", "Merchant", "Captain", "Admin", "Backend", "E2E"] },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "uniqueItems": true
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 },
      "uniqueItems": true
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "behavior", "decisionRefs"],
      "properties": {
        "status": { "enum": ["applicable", "not-applicable", "blocked"] },
        "reason": { "type": "string", "minLength": 20 },
        "behavior": { "$ref": "#/$defs/strings" },
        "decisionRefs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^BD-[0-9]{3}$" },
          "uniqueItems": true
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "trigger"],
      "properties": {
        "from": { "type": "string", "minLength": 2 },
        "to": { "type": "string", "minLength": 2 },
        "trigger": { "type": "string", "minLength": 10 }
      }
    },
    "actors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initiators", "allowed", "denied"],
      "properties": {
        "initiators": { "$ref": "#/$defs/nonEmptyStrings" },
        "allowed": { "$ref": "#/$defs/nonEmptyStrings" },
        "denied": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "contractIds",
        "priority",
        "actors",
        "given",
        "when",
        "then",
        "stateTransitions",
        "requiredFixtures",
        "apiRequest",
        "apiResponse",
        "errorCodes",
        "authorizationMatrix",
        "databaseInvariant",
        "applicability",
        "observabilityExpectations",
        "businessDecisionRefs",
        "featureBehavior",
        "requiredUnitTests",
        "requiredComponentTests",
        "requiredIntegrationTests",
        "requiredContractTests",
        "requiredE2ETests",
        "evidenceRequiredToActivate"
      ],
      "properties": {
        "scenarioId": { "type": "string", "pattern": "^SCN-[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}$" },
        "contractIds": { "$ref": "#/$defs/nonEmptyStrings" },
        "priority": { "enum": ["P0-launch", "P1"] },
        "actors": { "$ref": "#/$defs/actors" },
        "given": { "$ref": "#/$defs/nonEmptyStrings" },
        "when": { "$ref": "#/$defs/nonEmptyStrings" },
        "then": { "$ref": "#/$defs/nonEmptyStrings" },
        "stateTransitions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transition" }
        },
        "requiredFixtures": { "$ref": "#/$defs/nonEmptyStrings" },
        "apiRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation", "fields"],
          "properties": {
            "kind": { "enum": ["http", "client", "internal", "database"] },
            "operation": { "type": "string", "minLength": 3 },
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "path": { "type": "string", "pattern": "^/api/v1/" },
            "interface": { "type": "string", "minLength": 3 },
            "fields": { "$ref": "#/$defs/nonEmptyStrings" }
          },
          "allOf": [
            {
              "if": { "properties": { "kind": { "const": "http" } } },
              "then": {
                "properties": { "method": {}, "path": {} },
                "required": ["method", "path"]
              },
              "else": { "properties": { "interface": {} }, "required": ["interface"] }
            }
          ]
        },
        "apiResponse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields", "errorEnvelope"],
          "properties": {
            "fields": { "$ref": "#/$defs/nonEmptyStrings" },
            "errorEnvelope": { "type": "string", "minLength": 10 }
          }
        },
        "errorCodes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "uniqueItems": true
        },
        "authorizationMatrix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "denied", "ownershipRules"],
          "properties": {
            "allowed": { "$ref": "#/$defs/nonEmptyStrings" },
            "denied": { "$ref": "#/$defs/nonEmptyStrings" },
            "ownershipRules": { "$ref": "#/$defs/nonEmptyStrings" }
          }
        },
        "databaseInvariant": { "type": "string", "minLength": 20 },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idempotency",
            "concurrency",
            "offlineRetry",
            "audit",
            "accessibility",
            "businessDecision"
          ],
          "properties": {
            "idempotency": { "$ref": "#/$defs/requirement" },
            "concurrency": { "$ref": "#/$defs/requirement" },
            "offlineRetry": { "$ref": "#/$defs/requirement" },
            "audit": { "$ref": "#/$defs/requirement" },
            "accessibility": { "$ref": "#/$defs/requirement" },
            "businessDecision": { "$ref": "#/$defs/requirement" }
          }
        },
        "observabilityExpectations": { "$ref": "#/$defs/nonEmptyStrings" },
        "businessDecisionRefs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^BD-[0-9]{3}$" },
          "uniqueItems": true
        },
        "featureBehavior": { "$ref": "#/$defs/nonEmptyStrings" },
        "requiredUnitTests": { "$ref": "#/$defs/nonEmptyStrings" },
        "requiredComponentTests": { "$ref": "#/$defs/nonEmptyStrings" },
        "requiredIntegrationTests": { "$ref": "#/$defs/nonEmptyStrings" },
        "requiredContractTests": { "$ref": "#/$defs/nonEmptyStrings" },
        "requiredE2ETests": { "$ref": "#/$defs/nonEmptyStrings" },
        "evidenceRequiredToActivate": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  }
}
