{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "application", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "application": { "type": "string" },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenarioId",
          "contractIds",
          "priority",
          "given",
          "when",
          "then",
          "requiredFixtures",
          "apiRequest",
          "apiResponse",
          "errorCodes",
          "authorizationMatrix",
          "databaseInvariant",
          "duplicateRetryExpectation",
          "concurrencyExpectation",
          "offlineReconnectExpectation",
          "accessibilityExpectation",
          "requiredUnitTests",
          "requiredComponentTests",
          "requiredIntegrationTests",
          "requiredContractTests",
          "requiredE2ETests",
          "evidenceRequiredToActivate"
        ],
        "properties": {
          "scenarioId": { "type": "string", "pattern": "^SCN-" },
          "contractIds": { "$ref": "#/$defs/nonEmptyStrings" },
          "priority": { "enum": ["P0-launch", "P1"] },
          "given": { "$ref": "#/$defs/nonEmptyStrings" },
          "when": { "$ref": "#/$defs/nonEmptyStrings" },
          "then": { "$ref": "#/$defs/nonEmptyStrings" },
          "requiredFixtures": { "$ref": "#/$defs/nonEmptyStrings" },
          "apiRequest": { "type": "object" },
          "apiResponse": { "type": "object" },
          "errorCodes": { "$ref": "#/$defs/nonEmptyStrings" },
          "authorizationMatrix": { "type": "object" },
          "databaseInvariant": { "type": "string", "minLength": 20 },
          "duplicateRetryExpectation": { "$ref": "#/$defs/nonEmptyStrings" },
          "concurrencyExpectation": { "$ref": "#/$defs/nonEmptyStrings" },
          "offlineReconnectExpectation": { "$ref": "#/$defs/nonEmptyStrings" },
          "accessibilityExpectation": { "$ref": "#/$defs/nonEmptyStrings" },
          "requiredUnitTests": { "$ref": "#/$defs/nonEmptyStrings" },
          "requiredComponentTests": { "$ref": "#/$defs/nonEmptyStrings" },
          "requiredIntegrationTests": { "$ref": "#/$defs/nonEmptyStrings" },
          "requiredContractTests": { "$ref": "#/$defs/nonEmptyStrings" },
          "requiredE2ETests": { "$ref": "#/$defs/nonEmptyStrings" },
          "evidenceRequiredToActivate": { "$ref": "#/$defs/nonEmptyStrings" }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    }
  }
}
