{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "contracts"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractId",
          "title",
          "domain",
          "description",
          "producer",
          "consumers",
          "owningModule",
          "status",
          "criticality",
          "version",
          "preconditions",
          "successBehavior",
          "errorBehavior",
          "authorization",
          "tenantOutletIsolation",
          "idempotency",
          "concurrency",
          "offlineRetryBehavior",
          "observabilityExpectations",
          "accessibilityExpectations",
          "legacyProvenance",
          "plannedImplementationWorkstream",
          "requiredTestLayers",
          "executableTestPaths"
        ],
        "properties": {
          "contractId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}$" },
          "title": { "type": "string", "minLength": 3 },
          "domain": { "enum": ["Customer", "Merchant", "Captain", "Admin", "Backend", "E2E"] },
          "description": { "type": "string", "minLength": 20 },
          "producer": { "type": "string", "minLength": 2 },
          "consumers": { "$ref": "#/$defs/nonEmptyStrings" },
          "owningModule": { "type": "string", "minLength": 2 },
          "status": { "enum": ["active", "planned"] },
          "criticality": { "enum": ["foundation", "launch-critical", "high", "medium"] },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "preconditions": { "$ref": "#/$defs/nonEmptyStrings" },
          "successBehavior": { "$ref": "#/$defs/nonEmptyStrings" },
          "errorBehavior": { "$ref": "#/$defs/nonEmptyStrings" },
          "authorization": { "$ref": "#/$defs/nonEmptyStrings" },
          "tenantOutletIsolation": { "$ref": "#/$defs/nonEmptyStrings" },
          "idempotency": { "$ref": "#/$defs/nonEmptyStrings" },
          "concurrency": { "$ref": "#/$defs/nonEmptyStrings" },
          "offlineRetryBehavior": { "$ref": "#/$defs/nonEmptyStrings" },
          "observabilityExpectations": { "$ref": "#/$defs/nonEmptyStrings" },
          "accessibilityExpectations": { "$ref": "#/$defs/nonEmptyStrings" },
          "legacyProvenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sourceRepository", "sourceSha", "sourcePath", "note"],
              "properties": {
                "sourceRepository": { "type": "string" },
                "sourceSha": { "type": "string" },
                "sourcePath": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          },
          "plannedImplementationWorkstream": { "type": "string", "minLength": 2 },
          "requiredTestLayers": { "$ref": "#/$defs/nonEmptyStrings" },
          "executableTestPaths": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    }
  }
}
