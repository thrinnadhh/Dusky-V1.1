{
  "name": "@dusky/admin-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "test:coverage": "vitest run --coverage.enabled true --coverage.provider v8 --coverage.thresholds.lines 80 --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "config:validate": "node ../../scripts/validate-app-config.mjs admin-web",
    "build": "next build"
  },
  "dependencies": {
    "@dusky/contracts": "workspace:*",
    "next": "16.3.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "3.2.4"
  }
}
